---
interface Props{
    id: string;
    title: string;
    description: string;
    pubDate: string;
}

const {id, title, description, pubDate } = Astro.props as Props;
const date = pubDate ? new Date(pubDate) : undefined;
const formattedDate = date && !Number.isNaN(date.valueOf()) ? date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
}) : undefined;
---

<li>
    <a href={`/blog/${id}`} aria-label={`Read ${title} blog post`} data-astro-prefetch>
        <div class="top">
            <h1 class="title">{title}</h1>
            <time class="date">{formattedDate}</time>
        </div>
        <div class="bottom">
            <span class="description">{description}</span>
        </div>
    </a>
</li>

