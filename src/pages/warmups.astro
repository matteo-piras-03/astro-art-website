---
import Seo from '../components/Seo.astro';
import Layout from '../layouts/warmup_pages.astro';
import Warmups from '../components/Warmups.jsx';
const MEDIA_SUBDOMAIN = import.meta.env.PUBLIC_MEDIA_DOMAIN;
const DOMAIN = import.meta.env.SITE;
---

<Seo slot="head" 
	url={DOMAIN + Astro.url.pathname}
	pagetitle="Warmup Generator - pirAs03"
	title="pirAs03 - Warmup Generator"
	description="A simple warmup drawing exercises generator complete with timer, instructions and score system, fully customizable by the user."
	image={MEDIA_SUBDOMAIN + "/image/asset/previews/warmups.jpg"}
/>
<Layout warmupactive="warmups">
	<Warmups client:load/>
</Layout>
